APP_ENV=production
API_PREFIX=/api
LOG_LEVEL=INFO

DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/docflow?charset=utf8mb4
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=720

CAPTCHA_EXPIRE_SECONDS=180
UPLOAD_DIR=./backend/data/uploads
UPLOAD_MAX_MB=30

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-max
QWEN_EMBEDDING_MODEL=text-embedding-v3
QWEN_VISION_MODEL=qwen-vl-max
EMBEDDING_PROVIDER=bge_m3
BGE_M3_MODEL=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_BATCH_SIZE=8
BGE_LOCAL_FILES_ONLY=true
RERANKER_ENABLED=true
BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=20
EMBEDDING_DIM=1024

REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_EMBEDDING_TTL_SECONDS=86400
REDIS_ANSWER_TTL_SECONDS=3600
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_DATABASE=default
MILVUS_COLLECTION=docflow_chunks

RETRIEVAL_TOP_K=6
DENSE_TOP_K=20
BM25_TOP_K=20
MAX_CONTEXT_CHARS=12000
DEFAULT_HISTORY_TURNS=5

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
